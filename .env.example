# 本地 FastAPI CORS
ALLOWED_ORIGINS=http://localhost:4321

# 本地落库开关。Cloudflare 上建议使用 D1，同一套 SQL schema 可迁移。
DATA_CACHE_ENABLED=true
DATABASE_URL=sqlite:///data/nsy.sqlite3
D1_BINDING=DB

# 抓取/落库窗口
EVENT_FETCH_PAST_DAYS=183
EVENT_FETCH_FUTURE_DAYS=183
SNS_FETCH_PAST_DAYS=183

# 展示窗口
EVENT_DISPLAY_PAST_DAYS=183
EVENT_DISPLAY_FUTURE_DAYS=183
SNS_DISPLAY_PAST_DAYS=183

# 定时抓取。Cloudflare Cron 以每分钟触发 Worker，再由应用层按下面的间隔决定是否真的执行。
# 本地 uvicorn 开发默认建议关闭；上线到 Worker 时可打开。
SCHEDULER_ENABLED=false
SNS_SYNC_INTERVAL_MINUTES=10
EVENT_SYNC_INTERVAL_MINUTES=60

# 本地图片存储抽象。当前只实现 local，后续可扩展图床/S3/R2。
MEDIA_ROOT=data/media
MEDIA_PUBLIC_PREFIX=/media

# X API v2: 用于读取用户 tweets，并通过 exclude=retweets,replies 过滤转发/回复。
# 需要你在 X Developer Portal 创建 app 后提供 Bearer Token。
X_BEARER_TOKEN=

# 翻译 provider：
# - none：保留原文写入中文字段，便于本地无 Key 开发
# - mock：测试用，给中文字段加前缀
# - deepl：调用 DeepL API 写入中文字段，需要 DEEPL_API_KEY
TRANSLATION_PROVIDER=none
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com/v2/translate
